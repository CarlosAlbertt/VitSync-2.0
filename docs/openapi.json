{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Errors follow RFC 9457 with the extensions `code` and `traceId`.",
    "title" : "VitSync API",
    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Public catalog: specialties, facilities and doctors",
    "name" : "Catalog"
  }, {
    "description" : "The authenticated user",
    "name" : "Me"
  }, {
    "description" : "Registration, verification, session and password recovery",
    "name" : "Auth"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "Returns a 15-minute access token and sets the refresh token in an HttpOnly cookie. Unknown email and wrong password get the same 401. An unverified account gets 403 ACCOUNT_NOT_VERIFIED and a new verification code by email if the previous one is no longer usable.",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "Session started",
            "headers" : {
              "Set-Cookie" : {
                "description" : "vitsync_refresh=<opaque>; HttpOnly; Secure; SameSite=Lax; Path=/api/v1/auth; Max-Age=604800",
                "style" : "simple"
              }
            }
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "INVALID_CREDENTIALS"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "ACCOUNT_NOT_VERIFIED or ACCOUNT_DISABLED"
          }
        },
        "security" : [ ],
        "summary" : "Log in",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Revokes the session of the refresh cookie (its whole token family) and clears the cookie. Always 204, even without a cookie: the result for the client is the same.",
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Logged out"
          }
        },
        "security" : [ ],
        "summary" : "Log out",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/password-reset" : {
      "post" : {
        "description" : "Changes the password and revokes every session (all refresh token families). Access tokens already issued expire on their own within 15 minutes.",
        "operationId" : "resetPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password changed; log in again"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED, PASSWORD_BREACHED or INVALID_OR_EXPIRED_CODE"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "TOO_MANY_ATTEMPTS: the code is burnt; request a new one"
          }
        },
        "security" : [ ],
        "summary" : "Set a new password with the emailed code",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/password-reset/request" : {
      "post" : {
        "description" : "Always 202 with an empty body, whether or not the account exists. If it exists and is active, a 6-digit code valid for 15 minutes is emailed (at most one per minute).",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequestRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Request accepted"
          }
        },
        "security" : [ ],
        "summary" : "Request a password reset code",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Exchanges the refresh cookie for a new access token and a new refresh cookie of the same family; the presented token is revoked. Presenting an already used token revokes the whole family (theft signal) and is recorded in audit_logs. Clients must serialize refresh calls.",
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "Session renewed",
            "headers" : {
              "Set-Cookie" : {
                "description" : "The new refresh cookie",
                "style" : "simple"
              }
            }
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "INVALID_REFRESH_TOKEN: missing, expired, revoked or reused; the cookie is cleared"
          }
        },
        "security" : [ ],
        "summary" : "Rotate the refresh token",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "description" : "Creates the account in PENDING_VERIFICATION, together with its patient profile, and emails a 6-digit verification code valid for 10 minutes.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistrationResponse"
                }
              }
            },
            "description" : "Account created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED or PASSWORD_BREACHED"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "ACCOUNT_ALREADY_EXISTS (does not say which field)"
          }
        },
        "security" : [ ],
        "summary" : "Register a patient",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/verify" : {
      "post" : {
        "description" : "Activates the account. Unknown email, wrong, expired or used code all get the same 400.",
        "operationId" : "verify",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Account active"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED or INVALID_OR_EXPIRED_CODE"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "TOO_MANY_ATTEMPTS: the code is burnt; logging in again sends a new one"
          }
        },
        "security" : [ ],
        "summary" : "Verify the email with the emailed code",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/doctors" : {
      "get" : {
        "description" : "Sorted by last name. Filters are applied in the database; an unknown specialty or facility returns an empty page, not an error.",
        "operationId" : "list_2",
        "parameters" : [ {
          "description" : "Specialty slug, e.g. cardiologia",
          "in" : "query",
          "name" : "specialty",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          }
        }, {
          "description" : "Facility publicId",
          "in" : "query",
          "name" : "facility",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "Zero-based page number",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseDoctorResponse"
                }
              }
            },
            "description" : "A page of doctors"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED or MALFORMED_REQUEST (facility is not a UUID)"
          }
        },
        "security" : [ ],
        "summary" : "List the doctors open to the public",
        "tags" : [ "Catalog" ]
      }
    },
    "/api/v1/facilities" : {
      "get" : {
        "description" : "Sorted by city and then by name.",
        "operationId" : "list_1",
        "parameters" : [ {
          "description" : "Zero-based page number",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseFacilityResponse"
                }
              }
            },
            "description" : "A page of facilities"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          }
        },
        "security" : [ ],
        "summary" : "List active facilities",
        "tags" : [ "Catalog" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "The user"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "Get the authenticated user",
        "tags" : [ "Me" ]
      },
      "patch" : {
        "description" : "Absent fields are left unchanged. Email, NIF and role cannot be changed here.",
        "operationId" : "update",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateMeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "The updated user"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "Update the authenticated user's own data",
        "tags" : [ "Me" ]
      }
    },
    "/api/v1/specialties" : {
      "get" : {
        "description" : "Sorted by name. The text search matches the name with or without accents.",
        "operationId" : "list",
        "parameters" : [ {
          "description" : "Free text over the name",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          }
        }, {
          "in" : "query",
          "name" : "kind",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "MEDICAL", "SURGICAL", "DIAGNOSTIC", "GENERAL", "UNIT" ]
          }
        }, {
          "description" : "Zero-based page number",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseSpecialtyResponse"
                }
              }
            },
            "description" : "A page of specialties"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED or MALFORMED_REQUEST (unknown kind)"
          }
        },
        "security" : [ ],
        "summary" : "List active specialties",
        "tags" : [ "Catalog" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "DoctorResponse" : {
        "type" : "object",
        "properties" : {
          "bio" : {
            "type" : [ "string", "null" ],
            "example" : "Cardiología preventiva y rehabilitación tras un evento cardíaco."
          },
          "facilities" : {
            "type" : "array",
            "description" : "Active facilities where the doctor sees patients",
            "items" : {
              "$ref" : "#/components/schemas/FacilitySummary"
            }
          },
          "firstName" : {
            "type" : "string",
            "example" : "Marta"
          },
          "lastName" : {
            "type" : "string",
            "example" : "Bellver Ros"
          },
          "licenseNumber" : {
            "type" : "string",
            "description" : "Medical license number (public)",
            "example" : "46/10274"
          },
          "publicId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "specialty" : {
            "$ref" : "#/components/schemas/SpecialtySummary"
          }
        },
        "required" : [ "bio", "facilities", "firstName", "lastName", "licenseNumber", "publicId", "specialty" ]
      },
      "FacilityResponse" : {
        "type" : "object",
        "properties" : {
          "address" : {
            "type" : "string",
            "example" : "Paseo de la Ribera 12"
          },
          "city" : {
            "type" : "string",
            "example" : "València"
          },
          "name" : {
            "type" : "string",
            "example" : "Centro Jardín del Turia"
          },
          "phone" : {
            "type" : [ "string", "null" ],
            "example" : "+34 960 000 010"
          },
          "postalCode" : {
            "type" : "string",
            "example" : "46010"
          },
          "publicId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "address", "city", "name", "phone", "postalCode", "publicId" ]
      },
      "FacilitySummary" : {
        "type" : "object",
        "properties" : {
          "city" : {
            "type" : "string",
            "example" : "València"
          },
          "name" : {
            "type" : "string",
            "example" : "Centro Jardín del Turia"
          },
          "publicId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "city", "name", "publicId" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "paciente@vitsync.test",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "paciente@vitsync.test"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "firstName" : {
            "type" : "string",
            "example" : "Lucía"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastName" : {
            "type" : "string",
            "example" : "García Pérez"
          },
          "locale" : {
            "type" : "string",
            "example" : "es-ES"
          },
          "phone" : {
            "type" : [ "string", "null" ],
            "example" : "+34600000000"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "PATIENT", "DOCTOR", "ADMIN" ]
          }
        },
        "required" : [ "email", "emailVerified", "firstName", "id", "lastName", "locale", "phone", "role" ]
      },
      "PageMetadata" : {
        "type" : "object",
        "properties" : {
          "number" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 20
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 12
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 1
          }
        },
        "required" : [ "number", "size", "totalElements", "totalPages" ]
      },
      "PageResponseDoctorResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DoctorResponse"
            }
          },
          "page" : {
            "$ref" : "#/components/schemas/PageMetadata"
          }
        },
        "required" : [ "content", "page" ]
      },
      "PageResponseFacilityResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FacilityResponse"
            }
          },
          "page" : {
            "$ref" : "#/components/schemas/PageMetadata"
          }
        },
        "required" : [ "content", "page" ]
      },
      "PageResponseSpecialtyResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SpecialtyResponse"
            }
          },
          "page" : {
            "$ref" : "#/components/schemas/PageMetadata"
          }
        },
        "required" : [ "content", "page" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "123456",
            "minLength" : 1,
            "pattern" : "^\\d{6}$"
          },
          "email" : {
            "type" : "string",
            "example" : "paciente@vitsync.test",
            "maxLength" : 254,
            "minLength" : 0
          },
          "newPassword" : {
            "type" : "string",
            "description" : "12+ characters, at most 72 bytes in UTF-8",
            "minLength" : 12
          }
        },
        "required" : [ "code", "email", "newPassword" ]
      },
      "PasswordResetRequestRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "paciente@vitsync.test",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date",
            "example" : "1990-05-17"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "example" : "paciente@vitsync.test",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "example" : "Lucía",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "example" : "García Pérez",
            "maxLength" : 100,
            "minLength" : 0
          },
          "nif" : {
            "type" : "string",
            "description" : "Spanish NIF (DNI) or NIE with a valid control letter",
            "example" : "12345678Z",
