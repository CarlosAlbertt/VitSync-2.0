{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Errors follow RFC 9457 with the extensions `code` and `traceId`.",
    "title" : "VitSync API",
    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Registration, verification, session and password recovery",
    "name" : "Auth"
  } ],
  "paths" : {
    "/api/v1/auth/register" : {
      "post" : {
        "description" : "Creates the account in PENDING_VERIFICATION, together with its patient profile.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistrationResponse"
                }
              }
            },
            "description" : "Account created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "VALIDATION_FAILED or PASSWORD_BREACHED"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "ACCOUNT_ALREADY_EXISTS (does not say which field)"
          }
        },
        "security" : [ ],
        "summary" : "Register a patient",
        "tags" : [ "Auth" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date",
            "example" : "1990-05-17"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "example" : "paciente@vitsync.test",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "example" : "Lucía",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "example" : "García Pérez",
            "maxLength" : 100,
            "minLength" : 0
          },
          "nif" : {
            "type" : "string",
            "description" : "Spanish NIF (DNI) or NIE with a valid control letter",
            "example" : "12345678Z",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "description" : "12+ characters, at most 72 bytes in UTF-8",
            "minLength" : 12
          },
          "phone" : {
            "type" : "string",
            "example" : "+34600000000",
            "pattern" : "^\\+?[0-9]{9,15}$"
          }
        },
        "required" : [ "birthDate", "email", "firstName", "lastName", "nif", "password" ]
      },
      "RegistrationResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "paciente@vitsync.test"
          },
          "status" : {
            "type" : "string",
            "example" : "PENDING_VERIFICATION"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
