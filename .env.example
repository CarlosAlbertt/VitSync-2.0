# Variables de entorno de VitSync 2.0 (guía, Anexo C).
#
# Este fichero se versiona y NO lleva valores reales: es el contrato de qué necesita la
# aplicación para arrancar. Cópialo a .env y rellénalo, o inyecta las variables desde el
# gestor de secretos del entorno.
#
# En desarrollo NO hace falta ninguna de estas: el perfil "local"
# (apps/api/src/main/resources/application-local.properties) apunta al docker-compose.
#
# Regla: ningún valor real entra en el repositorio, en ninguna rama. gitleaks lo vigila
# en CI. v1 tuvo credenciales en el historial de git; no se repite.

# ------------------------------- API -------------------------------

# Base de datos
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Origenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=

# Firma de tokens (ADR-0004). Par RSA de 2048+ bits en PEM (privada PKCS#8, publica X.509);
# la privada solo la tiene la API. Se admiten los saltos de linea escritos como \n.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cifrado en reposo (ADR-0005).
# ENCRYPTION_KEY: 32 bytes en base64.
# ENCRYPTION_KEY_VERSION: version con la que se cifra AHORA, con formato v<n> (p. ej. v1).
#   Los valores guardados llevan prefijo "v<n>:". Tras rotar, la clave antigua sigue
#   haciendo falta para descifrar: VITSYNC_CRYPTO_PREVIOUS_KEYS_V1=<base64>.
# BLIND_INDEX_PEPPER: secreto del HMAC del blind index, 32+ caracteres. DISTINTO de ENCRYPTION_KEY
#   y guardado aparte: quien tenga la BD y el pepper puede comprobar si un NIF existe.
# Perder ENCRYPTION_KEY es perder los datos: su custodia es parte del despliegue.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=
BLIND_INDEX_PEPPER=

# Almacenamiento de ficheros (ADR-0006). El bucket es SIEMPRE privado.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Correo transaccional por SMTP (el proveedor se decide en el Sprint 8).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# URL publica de la aplicacion, para los enlaces de los emails
APP_BASE_URL=

# -------------------------- Desarrollo local --------------------------
# Solo para el docker-compose del repo; no se usa en despliegue. docker compose lee
# este fichero si lo copias a .env. Por defecto 5433, para no chocar con un
# PostgreSQL instalado en la maquina (ver CONTRIBUTING).

DB_PORT=5433

# ------------------------------- Web -------------------------------
# (a partir de la Fase 9)

VITE_API_URL=
VITE_APP_ENV=
# Qué simula MSW en el navegador: all (todo), missing (solo lo que el backend aún no tiene) o
# none. Por defecto: missing con pnpm dev, all con pnpm dev:mocks y none en el build.
VITE_API_MOCKS=
VITE_SENTRY_DSN=
